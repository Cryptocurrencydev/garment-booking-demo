# Postgres (Neon via Vercel Marketplace sets DATABASE_URL automatically)
DATABASE_URL=postgres://localhost/garment_dev

# Square (sandbox) — Developer Dashboard → your app → Sandbox
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=sandbox-sq0idb-...
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=        # from the webhook subscription
SQUARE_WEBHOOK_URL=https://<your-domain>/api/webhooks/square   # must match the subscription URL exactly

# Uber Direct — leave empty to run the "sandbox pending" mock
UBER_CUSTOMER_ID=
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_WEBHOOK_SIGNING_KEY=

# App
APP_URL=https://<your-domain>
SESSION_SECRET=                      # 32+ random chars
ADMIN_PASSWORD=
OWNER_EMAIL=owner@example.com
OWNER_PHONE=

# Optional notifications (without keys messages go to the outbox shown in /admin)
RESEND_API_KEY=
EMAIL_FROM="Marlowe & Finch <onboarding@resend.dev>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
